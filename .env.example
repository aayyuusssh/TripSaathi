# Local development only. No real customer accounts or transactions in this chunk.
DATABASE_URL=postgresql://tripsaathi:tripsaathi_local@127.0.0.1:5432/tripsaathi?schema=public
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
APP_MODE=demo
AUTH_MODE=demo
# Use AUTH_MODE=clerk for managed frontend login + verified backend identity.
# AUTH_MODE=clerk
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional custom OIDC audience requires matching Clerk JWT template.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://your-identity-provider.example/
# OIDC_AUDIENCE=tripsaathi-api
# OIDC_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai
TINYFISH_TRIP_DAILY_RUN_LIMIT=3
# Optional HTTPS callback base. Leave empty for local polling; no tunnel is opened.
# TINYFISH_CALLBACK_BASE_URL=https://your-api.example
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_DAILY_CALL_LIMIT=200
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TRIP_DAILY_CALL_LIMIT=2
GEMINI_IMPORT_MODEL=gemini-3.1-flash-lite
IMPORT_DAILY_EXTRACTION_LIMIT=3
IMPORT_RETENTION_HOURS=24
# Optional base64 32-byte encryption key. Otherwise generated in ignored .private/keys/imports.key.
# Back up/protect that local key; loss makes retained originals unreadable.
# IMPORT_ENCRYPTION_KEY=

# Future adapters — adding a key alone does not enable them.
# Obtain only the provider(s) you choose; do not buy every service now.
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_ENV=test
# GOOGLE_MAPS_API_KEY=
# RAIL_PROVIDER_BASE_URL=
# RAIL_PROVIDER_API_KEY=
# TRANSFER_PROVIDER_BASE_URL=
# TRANSFER_PROVIDER_API_KEY=

# Cardless signup alternatives. Plan fields/coverage still require real-key verification.
# Auto-select AirLabs when its key exists; FLIGHT_STATUS_PROVIDER can explicitly select AIRLABS or FLIGHTAWARE.
AIRLABS_API_KEY=
AIRLABS_DAILY_CALL_LIMIT=10
AIRLABS_MONTHLY_CALL_LIMIT=50
# FLIGHT_STATUS_PROVIDER=AIRLABS
SERPAPI_API_KEY=


SERPAPI_MONTHLY_SEARCH_LIMIT=50
